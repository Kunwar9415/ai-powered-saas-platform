# ==============================================================================
# AI-POWERED SAAS PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# Three-Tier Web Architecture with Local Generative AI Inference Layer
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_btech_project_2026_saas
JWT_EXPIRES_IN=7d

# PostgreSQL Database Connection String (Prisma ORM)
# Example local: postgresql://postgres:password@localhost:5432/omni_ai_saas?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/omni_ai_saas?schema=public"

# ==============================================================================
# LOCAL AI INFERENCE ENGINE (OLLAMA RUNTIME)
# ==============================================================================
# Base URL for the local Ollama HTTP daemon
OLLAMA_BASE_URL=http://localhost:11434

# Open-weight model executed locally (e.g. gpt-oss:20b, llama3:latest, mistral)
OLLAMA_MODEL=gpt-oss:20b

# Local inference timeout in milliseconds (default: 120000ms / 2 minutes)
OLLAMA_TIMEOUT_MS=120000

# Default AI Provider
DEFAULT_AI_PROVIDER=ollama

# ==============================================================================
# MODULAR AI SERVICES (VISION & DOCUMENT)
# ==============================================================================
# Modular Image Synthesis Engine (Decoupled from text LLM)
IMAGE_SYNTHESIZER_ENGINE=modular-vision-pipeline

# File Upload Settings
MAX_FILE_SIZE_MB=20
