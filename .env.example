# ==============================================================================
# AI-POWERED SAAS PLATFORM - HYBRID ARCHITECTURE ENVIRONMENT TEMPLATE
# Google Gemini API (Text & Document) + In-House PyTorch Model (Resume Detection)
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_btech_project_2026_saas
JWT_EXPIRES_IN=7d

# PostgreSQL Database Connection String (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/omni_ai_saas?schema=public"

# ==============================================================================
# 1. GOOGLE GEMINI API (Text Generation & Document Intelligence)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ==============================================================================
# 2. IN-HOUSE CUSTOM AI INFERENCE SERVICE (FastAPI + PyTorch on :8000)
# Strictly powers Resume Detection & ATS Analysis with 100% Data Sovereignty
# ==============================================================================
CUSTOM_AI_SERVICE_URL=http://localhost:8000
CUSTOM_AI_TIMEOUT_MS=60000
DEFAULT_AI_PROVIDER=gemini

# File Upload Settings
MAX_FILE_SIZE_MB=20
